---
import Layout  from './Layout.astro'
import Content from './Content.astro'
import RepositoryButton from '../components/RepositoryButton.astro'
import Learnings from '../components/Learnings.astro'
import '../styles/markdown.css'


const {frontmatter} = Astro.props;
const {title, description, repos = [], learnings = []} = frontmatter;
---
<Layout {title} {description}>
    <Content>
        <article class="markdown">
            <div class="flex flex-col sm:flex-row mt-3 md:mt-4 mb-4 md:mb-6">
                <h1 class="backlink  hidden md:inline-block " transition:name="title-projects"><a href="/projects">Projects</a></h1>
                <h1 class=""> {title} </h1>
                {repos.length > 0 &&
                    <div class="flex flex-wrap gap-2 sm:ml-auto p-8 sm:p-0">
                        {repos.map((repo: {label?: string, url: string}) => <RepositoryButton link={repo.url} label={repo.label}/>)}
                    </div>
                }
            </div>
            {learnings.length > 0 && <Learnings {learnings} />}
            <div class="textbody">
            <slot/>
        </div>
    </article>
    </Content>
</Layout>

