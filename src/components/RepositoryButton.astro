---
import {Icon} from "astro-icon/components"

interface Props {
    link: string
    label?: string
}

const { link, label = "View Code" }  = Astro.props;
---
<a href={link}>
    <div class="group border flex gap-2 border-dark rounded px-3 h-[50px] hover:border-soft-white ">
        <p class="font-extralight text-xl leading-7 group-hover:text-soft-white py-3">{label}</p>
        <Icon size="40" class="text-dark group-hover:text-soft-white mt-1" name="fa7-brands:github"></Icon>
    </div>
</a>
